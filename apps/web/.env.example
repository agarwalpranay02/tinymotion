# Copy to .env.local. These values run the app locally as is:
# embedded Postgres (PGlite in .data/), sign-in emails printed to the console.
# For production, set the same names in your host (see FREE_HOSTING.md).

# ---- Public ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # production: https://your-domain
NEXT_PUBLIC_CONTACT_EMAIL=tinymotion.app@gmail.com

# ---- Database ----
# Leave DATABASE_URL unset to use embedded PGlite. Production: a Postgres URL, e.g. Neon's pooled URL.
# DATABASE_URL=postgres://user:password@host:5432/tinymotion
AUTO_MIGRATE=1

# ---- Auth (better-auth) ----
BETTER_AUTH_URL=http://localhost:3000               # production: https://your-domain
BETTER_AUTH_SECRET=            # required in production: openssl rand -hex 32
GOOGLE_CLIENT_ID=              # optional: Google sign-in
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=                # optional: contact-form notifications (and email sign-in with a verified domain)
EMAIL_FROM="TinyMotion <onboarding@resend.dev>"
CONTACT_INBOX=tinymotion.app@gmail.com

# ---- Developer API ----
API_KEY_PEPPER=                # required in production: openssl rand -hex 24 (never change after launch: invalidates keys)

# ---- Optional: shared rate limits across instances ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Local development only ----
ALLOW_DEV_LOGIN=0
TRUST_PROXY=1

# ---- Optional: OpenTelemetry tracing ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
